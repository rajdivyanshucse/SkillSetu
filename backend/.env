PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillsetu?schema=public

JWT_ACCESS_SECRET=skillsetu_jwt_access_secret_development_key_2026_super_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=skillsetu_jwt_refresh_secret_development_key_2026_super_secure
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_VERIFICATION_EXPIRES_MINUTES=1440
PASSWORD_RESET_EXPIRES_MINUTES=60
AUTH_COOKIE_SECURE=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BODY_SIZE_LIMIT=1mb

# AI Microservice Configuration (Python FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8001
