# ==========================================
# SkillSetu Environment Configuration Template
# Safe placeholder template for production & development
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillsetu_db?schema=public"

# Authentication & JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET="your-secure-jwt-access-secret-at-least-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-secure-jwt-refresh-secret-at-least-32-chars-long"
JWT_REFRESH_EXPIRES_IN="7d"
AUTH_COOKIE_SECURE=false

# Token Lifespans
EMAIL_VERIFICATION_EXPIRES_MINUTES=1440
PASSWORD_RESET_EXPIRES_MINUTES=60

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BODY_SIZE_LIMIT="1mb"

# Python AI/ML Microservice Integration
AI_SERVICE_URL="http://127.0.0.1:8001"
AI_SERVICE_API_KEY="sk-skillsetu-ai-dev-secret-key"
AI_TIMEOUT_MS=5000
