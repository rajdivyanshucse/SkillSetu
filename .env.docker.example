# ==============================================================================
# SkillSetu Docker Environment Configuration Template
# Copy this file to .env.docker or .env before running: docker compose up --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=skillsetu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Node.js Core Backend Configuration
# ------------------------------------------------------------------------------
PORT=5000
BACKEND_PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost
API_PREFIX=/api/v1
LOG_LEVEL=INFO
BODY_SIZE_LIMIT=1mb

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security (REPLACE IN PRODUCTION!)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=skillsetu-prod-access-token-secret-must-be-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=skillsetu-prod-refresh-token-secret-must-be-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. Python AI Microservice Integration
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8001
AI_SERVICE_API_KEY=sk-skillsetu-ai-dev-secret-key
AI_TIMEOUT_MS=5000
ENVIRONMENT=production
MAX_TEXT_LENGTH=50000

# ------------------------------------------------------------------------------
# 5. Frontend Production Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
VITE_API_URL=/api/v1
